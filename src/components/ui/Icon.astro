---
/**
 * ============================================================================
 *  ICON  —  Iconos SVG en linea
 * ============================================================================
 *  POR QUE NO UNA LIBRERIA DE ICONOS
 *  La plantilla original cargaba Bootstrap Icons entero: una hoja de estilos
 *  y una fuente de ~120 KB para usar unos 20 iconos. Aqui cada icono es un
 *  <path> que viaja dentro del HTML ya generado: cero peticiones de red,
 *  cero parpadeo al cargar y el icono hereda `currentColor`, asi que cambia
 *  de color solo con el texto que lo rodea.
 *
 *  PARA ANADIR UN ICONO
 *  Anade una entrada a PATHS con el contenido interno de un SVG de 24x24
 *  (viewBox="0 0 24 24"). Fuente recomendada: lucide.dev (licencia ISC).
 *
 *  ACCESIBILIDAD
 *  Por defecto el icono es decorativo: aria-hidden="true", invisible para
 *  lectores de pantalla. Si el icono es la UNICA informacion (por ejemplo un
 *  boton sin texto), pasa `label` y se convierte en img con nombre accesible.
 * ============================================================================
 */

/**
 * @typedef {Object} Props
 * @property {string}  name    Clave del icono en PATHS.
 * @property {number} [size]   Lado en px. Por defecto 20.
 * @property {string} [label]  Si se indica, el icono deja de ser decorativo.
 * @property {string} [class]  Clases extra.
 */
const { name, size = 20, label, class: className = '' } = Astro.props;

/** @type {Record<string, string>} */
const PATHS = {
  // --- Navegacion ---------------------------------------------------------
  home:     '<path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/>',
  user:     '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>',
  chart:    '<path d="M4 20V10"/><path d="M10 20V4"/><path d="M16 20v-7"/><path d="M22 20H2"/>',
  timeline: '<circle cx="6" cy="6" r="2.5"/><circle cx="6" cy="18" r="2.5"/><path d="M6 8.5v7"/><path d="M11 6h10"/><path d="M11 18h10"/>',
  grid:     '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>',
  star:     '<path d="m12 3 2.6 5.6 6.1.8-4.5 4.2 1.2 6.1L12 16.9 6.6 19.7l1.2-6.1L3.3 9.4l6.1-.8Z"/>',
  menu:     '<path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/>',
  close:    '<path d="m6 6 12 12"/><path d="m18 6-12 12"/>',

  // --- Contacto y redes ---------------------------------------------------
  mail:     '<rect x="2.5" y="5" width="19" height="14" rx="2.5"/><path d="m3 7 9 6 9-6"/>',
  phone:    '<path d="M6.5 3h3l1.5 4-2 1.5a12 12 0 0 0 5.5 5.5L16 12l4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 3 6.2 2 2 0 0 1 5 4Z"/>',
  whatsapp: '<path d="M3.5 20.5 5 16.4A8.2 8.2 0 1 1 8.1 19.5Z"/><path d="M9 9.5c0 3 2.5 5.5 5.5 5.5.6 0 1-.4 1-1v-.7l-2-.9-.8 1a6 6 0 0 1-2.6-2.6l1-.8-.9-2H9.9c-.5 0-.9.4-.9 1Z"/>',
  github:   '<path d="M9 19c-4 1.4-4-2.4-6-3m12 5v-3.6a3 3 0 0 0-.9-2.4c2.9-.3 6-1.5 6-6.5a5 5 0 0 0-1.4-3.5 4.6 4.6 0 0 0-.1-3.5s-1.1-.3-3.6 1.4a12.4 12.4 0 0 0-6.5 0C6 1.7 4.9 2 4.9 2a4.6 4.6 0 0 0-.1 3.5A5 5 0 0 0 3.4 9c0 5 3.1 6.2 6 6.5a3 3 0 0 0-.9 2.3V21"/>',
  linkedin: '<rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 10.5V17"/><circle cx="8" cy="7.5" r="1"/><path d="M12 17v-3.8a2.2 2.2 0 0 1 4.4 0V17"/><path d="M12 10.5V17"/>',
  location: '<path d="M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11Z"/><circle cx="12" cy="10" r="2.7"/>',
  external: '<path d="M14 4h6v6"/><path d="m20 4-8.5 8.5"/><path d="M19 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h5"/>',

  // --- Areas tecnicas -----------------------------------------------------
  server:   '<rect x="3" y="3.5" width="18" height="7" rx="2"/><rect x="3" y="13.5" width="18" height="7" rx="2"/><path d="M7 7h.01"/><path d="M7 17h.01"/>',
  network:  '<circle cx="12" cy="5" r="2.5"/><circle cx="5" cy="19" r="2.5"/><circle cx="19" cy="19" r="2.5"/><path d="M12 7.5v4"/><path d="M12 11.5 5.8 16.8"/><path d="m12 11.5 6.2 5.3"/>',
  code:     '<path d="m9 8-5 4 5 4"/><path d="m15 8 5 4-5 4"/>',
  terminal: '<rect x="2.5" y="4" width="19" height="16" rx="2.5"/><path d="m7 10 2.5 2L7 14"/><path d="M13 15h4"/>',
  shield:   '<path d="M12 2.5 20 6v5.5c0 5-3.4 8.6-8 10-4.6-1.4-8-5-8-10V6Z"/><path d="m9 12 2 2 4-4"/>',
  flow:     '<rect x="2.5" y="3" width="7" height="5" rx="1.5"/><rect x="14.5" y="3" width="7" height="5" rx="1.5"/><rect x="8.5" y="16" width="7" height="5" rx="1.5"/><path d="M6 8v3h12V8"/><path d="M12 11v5"/>',
  database: '<ellipse cx="12" cy="5.5" rx="7.5" ry="3"/><path d="M4.5 5.5v13c0 1.7 3.4 3 7.5 3s7.5-1.3 7.5-3v-13"/><path d="M4.5 12c0 1.7 3.4 3 7.5 3s7.5-1.3 7.5-3"/>',
  graduation:'<path d="m12 4 10 4.5-10 4.5L2 8.5Z"/><path d="M6 11v5c0 1.7 2.7 3 6 3s6-1.3 6-3v-5"/>',
  briefcase:'<rect x="2.5" y="7" width="19" height="13" rx="2.5"/><path d="M9 7V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5V7"/>',
  download: '<path d="M12 3v11"/><path d="m7.5 10 4.5 4.5 4.5-4.5"/><path d="M4 20h16"/>',
  arrowDown:'<path d="M12 4v15"/><path d="m6 13.5 6 6 6-6"/>',
  arrowRight:'<path d="M4 12h15"/><path d="m13.5 6 6 6-6 6"/>',
  sparkle:  '<path d="M12 3v5"/><path d="M12 16v5"/><path d="M3 12h5"/><path d="M16 12h5"/><path d="m6 6 3 3"/><path d="m15 15 3 3"/><path d="m18 6-3 3"/><path d="m9 15-3 3"/>',
  check:    '<path d="m5 12.5 4.5 4.5L19 7"/>',
};

const path = PATHS[name] ?? PATHS.sparkle;

// Decorativo -> se oculta al lector de pantalla. Con label -> es contenido.
const a11y = label
  ? { role: 'img', 'aria-label': label }
  : { 'aria-hidden': 'true', focusable: 'false' };
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  {...a11y}
  set:html={path}
/>
