---
/**
 * ============================================================================
 *  FOOTER
 * ============================================================================
 *  El año se calcula en el build con new Date(). Como el sitio se regenera
 *  cada vez que publicas, no hay riesgo de que se quede obsoleto, y a cambio
 *  no se envia ni un byte de JavaScript para pintar un numero.
 * ============================================================================
 */
import { profile } from '../../data/index.js';
import Icon from '../ui/Icon.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <p class="site-footer__copy">
      © {year} {profile.name}. Todos los derechos reservados.
    </p>

    <ul class="site-footer__socials" role="list">
      {profile.socials.map((social) => (
        <li>
          <a
            class="site-footer__link"
            href={social.href}
            target={social.href.startsWith('http') ? '_blank' : undefined}
            rel={social.href.startsWith('http') ? 'noopener noreferrer' : undefined}
          >
            <Icon name={social.icon} size={17} label={social.label} />
          </a>
        </li>
      ))}
    </ul>

    <p class="site-footer__built">
      Construido con Astro y React · Diseño propio
    </p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: var(--z-content);
    border-top: 1px solid var(--color-border);
    background: rgba(5, 6, 11, 0.7);
    backdrop-filter: blur(10px);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-5);
  }

  .site-footer__copy,
  .site-footer__built {
    font-size: var(--text-xs);
    color: var(--color-text-dim);
  }

  .site-footer__socials { display: flex; gap: var(--space-2); }

  .site-footer__link {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    transition: color var(--duration-fast) var(--ease-soft),
                border-color var(--duration-fast) var(--ease-soft);
  }

  .site-footer__link:hover {
    color: var(--color-plasma);
    border-color: hsl(var(--hsl-plasma) / 0.5);
  }

  @media (max-width: 640px) {
    .site-footer__inner { justify-content: center; text-align: center; }
  }
</style>
