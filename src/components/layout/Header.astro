---
/**
 * ============================================================================
 *  HEADER  —  Barra lateral fija (escritorio) / cajon deslizante (movil)
 * ============================================================================
 *  Conserva la estructura caracteristica de la plantilla iPortfolio: una
 *  columna fija a la izquierda con el nombre, las redes y el menu vertical.
 *  A partir de 1200 px hacia abajo se transforma en un boton hamburguesa que
 *  abre un cajon.
 *
 *  POR QUE ESTE COMPONENTE NO ES REACT
 *  Decision deliberada de rendimiento. Un menu tiene que responder desde el
 *  primer instante, asi que tendria que hidratarse con `client:load`, y eso
 *  significa descargar el runtime de React en la ruta critica (~45 KB) para
 *  abrir y cerrar un panel. Con ~30 lineas de JavaScript nativo se consigue
 *  lo mismo con 0 KB de dependencias. React se reserva para las islas donde
 *  de verdad aporta: el filtro de proyectos y el rotulo del hero, que se
 *  hidratan mas abajo con `client:visible` y no estorban la carga inicial.
 *
 *  ACCESIBILIDAD DEL CAJON
 *  · aria-expanded en el boton comunica el estado abierto/cerrado.
 *  · aria-controls enlaza el boton con el panel que gobierna.
 *  · Escape cierra; al cerrar, el foco vuelve al boton.
 *  · Mientras esta abierto se bloquea el scroll del documento.
 * ============================================================================
 */
import { navigation } from '../../config/site.js';
import { profile } from '../../data/index.js';
import Icon from '../ui/Icon.astro';
---

<!-- Boton hamburguesa: solo existe visualmente por debajo de 1200 px -->
<button
  type="button"
  class="nav-toggle"
  data-nav-toggle
  aria-expanded="false"
  aria-controls="menu-principal"
  aria-label="Abrir menú de navegación"
>
  <Icon name="menu" size={22} class="nav-toggle__icon nav-toggle__icon--open" />
  <Icon name="close" size={22} class="nav-toggle__icon nav-toggle__icon--close" />
</button>

<!-- Velo oscuro tras el cajon en movil. Clic = cerrar. -->
<div class="nav-scrim" data-nav-scrim hidden></div>

<header class="site-header" id="menu-principal" data-nav-panel>
  <div class="site-header__inner">
    <!-- Identidad -->
    <a class="brand" href="#inicio">
      <span class="brand__mark" aria-hidden="true">{profile.initials}</span>
      <span class="brand__text">
        <span class="brand__name">{profile.name}</span>
        <span class="brand__role">{profile.role}</span>
      </span>
    </a>

    <!-- Redes -->
    <ul class="social-rail" role="list">
      {profile.socials.map((social) => (
        <li>
          <a
            class="social-rail__link"
            href={social.href}
            target={social.href.startsWith('http') ? '_blank' : undefined}
            rel={social.href.startsWith('http') ? 'noopener noreferrer' : undefined}
          >
            <Icon name={social.icon} size={18} label={social.label} />
          </a>
        </li>
      ))}
    </ul>

    <!-- Menu. data-scrollspy lo conecta con src/scripts/scrollSpy.js -->
    <nav class="site-nav" data-scrollspy aria-label="Navegación principal">
      <ul role="list">
        {navigation.map((item) => (
          <li>
            <a class="site-nav__link" href={`#${item.id}`}>
              <Icon name={item.icon} size={17} />
              <span>{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <p class="site-header__foot">
      <Icon name="location" size={14} />
      {profile.location}
    </p>
  </div>
</header>

<style>
  /* ---------------------------------------------------------------- Barra */
  .site-header {
    position: fixed;
    inset-block: 0;
    inset-inline-start: 0;
    width: var(--sidebar-width, 280px);
    z-index: var(--z-header);
    background: rgba(8, 10, 20, 0.72);
    /* El desenfoque de fondo deja intuir las estrellas tras la barra */
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border-inline-end: 1px solid var(--color-border);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .site-header__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    min-height: 100%;
    padding: var(--space-6) var(--space-5);
  }

  /* --------------------------------------------------------------- Marca */
  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .brand__mark {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 46px;
    height: 46px;
    border-radius: var(--radius-full);
    background: var(--gradient-stela);
    color: #08090f;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-lg);
    box-shadow: 0 6px 26px -8px hsl(var(--hsl-nebula) / 0.9);
  }

  .brand__text { display: flex; flex-direction: column; }

  .brand__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.02rem;
    line-height: 1.25;
  }

  .brand__role {
    font-size: var(--text-xs);
    color: var(--color-text-dim);
    line-height: 1.35;
  }

  /* --------------------------------------------------------------- Redes */
  .social-rail { display: flex; gap: var(--space-2); }

  .social-rail__link {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    transition:
      color        var(--duration-fast) var(--ease-soft),
      border-color var(--duration-fast) var(--ease-soft),
      transform    var(--duration-fast) var(--ease-out);
  }

  .social-rail__link:hover {
    color: var(--color-plasma);
    border-color: hsl(var(--hsl-plasma) / 0.55);
    transform: translateY(-2px);
  }

  /* ---------------------------------------------------------------- Menu */
  .site-nav { flex: 1; }
  .site-nav ul { display: flex; flex-direction: column; gap: 2px; }

  .site-nav__link {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-3);
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 500;
    transition:
      color      var(--duration-fast) var(--ease-soft),
      background var(--duration-fast) var(--ease-soft);
  }

  .site-nav__link:hover {
    color: var(--color-text);
    background: rgba(255, 255, 255, 0.04);
  }

  /* Estado activo que marca el scroll-spy. Se engancha a aria-current, que
     es a la vez informacion para el lector de pantalla y gancho de estilo. */
  .site-nav__link[aria-current='true'] {
    color: var(--color-text);
    background: rgba(255, 255, 255, 0.06);
  }

  /* Barrita luminosa a la izquierda del enlace activo */
  .site-nav__link[aria-current='true']::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block: 22%;
    width: 3px;
    border-radius: var(--radius-full);
    background: var(--gradient-stela);
    box-shadow: 0 0 12px 1px hsl(var(--hsl-nebula) / 0.9);
  }

  .site-header__foot {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-dim);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  /* ------------------------------------------------------- Boton y velo */
  .nav-toggle {
    position: fixed;
    top: var(--space-4);
    inset-inline-start: var(--space-4);
    z-index: var(--z-drawer);
    display: none;          /* se activa en movil */
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: var(--radius-md);
    background: rgba(16, 19, 32, 0.9);
    backdrop-filter: blur(12px);
    border: 1px solid var(--color-border-strong);
    color: var(--color-text);
  }

  .nav-toggle__icon { position: absolute; transition: opacity var(--duration-fast) var(--ease-soft); }
  .nav-toggle__icon--close { opacity: 0; }
  .nav-toggle[aria-expanded='true'] .nav-toggle__icon--open  { opacity: 0; }
  .nav-toggle[aria-expanded='true'] .nav-toggle__icon--close { opacity: 1; }

  .nav-scrim {
    position: fixed;
    inset: 0;
    z-index: calc(var(--z-header) - 1);
    background: rgba(3, 4, 9, 0.72);
    backdrop-filter: blur(2px);
  }

  /* ------------------------------------------------------------- Movil */
  @media (max-width: 1199px) {
    .nav-toggle { display: grid; }

    .site-header {
      width: min(310px, 84vw);
      transform: translateX(-102%);
      transition: transform var(--duration-normal) var(--ease-out);
      box-shadow: var(--shadow-lg);
    }

    .site-header[data-open] { transform: translateX(0); }

    /* El contenido del cajon baja para no quedar bajo el boton hamburguesa */
    .site-header__inner { padding-top: calc(var(--space-6) + 46px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header { transition: none; }
  }
</style>

<script>
  /**
   * Control del cajon de navegacion en movil.
   * JavaScript nativo, sin dependencias: ~30 lineas frente a los ~45 KB que
   * costaria hidratar React en la ruta critica solo para esto.
   */
  const toggle = document.querySelector('[data-nav-toggle]');
  const panel  = document.querySelector('[data-nav-panel]');
  const scrim  = document.querySelector('[data-nav-scrim]');

  if (toggle instanceof HTMLElement && panel instanceof HTMLElement && scrim instanceof HTMLElement) {
    /** @param {boolean} open */
    const setOpen = (open) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Cerrar menú de navegación' : 'Abrir menú de navegación');
      panel.toggleAttribute('data-open', open);
      scrim.hidden = !open;
      // Bloquea el scroll del fondo mientras el cajon esta abierto
      document.body.style.overflow = open ? 'hidden' : '';
    };

    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

    toggle.addEventListener('click', () => setOpen(!isOpen()));
    scrim.addEventListener('click', () => setOpen(false));

    // Al elegir una seccion, el cajon se cierra solo
    panel.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a[href^="#"]')) {
        setOpen(false);
      }
    });

    // Escape cierra y devuelve el foco al boton, para no perder al usuario
    // que navega con teclado.
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) {
        setOpen(false);
        toggle.focus();
      }
    });

    // Si la ventana crece hasta escritorio con el cajon abierto, se restablece
    // el estado para que no quede el scroll bloqueado.
    window.matchMedia('(min-width: 1200px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
