---
/**
 * ============================================================================
 *  SECCION SOBRE MI
 * ============================================================================
 *  Dos columnas: retrato a la izquierda y perfil profesional + ficha de datos
 *  a la derecha. En movil se apilan.
 *
 *  EL RETRATO
 *  Si `profile.photo` esta vacio se dibuja un monograma con las iniciales
 *  dentro de un anillo orbital. Es una decision de honestidad: antes que
 *  poner la foto de archivo que traia la plantilla —una persona que no eres—
 *  se muestra un marcador de posicion que encaja con el tema.
 *  Para usar tu foto: copiala a public/images/perfil.jpg y escribe esa ruta
 *  en el campo `photo` de src/data/profile.js.
 * ============================================================================
 */
import { profile } from '../../data/index.js';
import SectionHeader from '../ui/SectionHeader.astro';
import Icon from '../ui/Icon.astro';

/** Ficha de datos rapida, en el mismo orden que la cabecera del CV. */
const datos = [
  { icon: 'location', label: 'Ubicación',      value: profile.location },
  { icon: 'mail',     label: 'Correo',         value: profile.email, href: `mailto:${profile.email}` },
  { icon: 'phone',    label: 'Teléfono',       value: profile.phone, href: `tel:${profile.phoneRaw}` },
  { icon: 'sparkle',  label: 'Disponibilidad', value: profile.availability },
];
---

<section class="section section--alt" id="sobre-mi" aria-labelledby="sobre-mi-titulo">
  <div class="container">
    <SectionHeader
      eyebrow="Perfil"
      title="Sobre mí"
      subtitle="Quién soy y en qué trabajo."
      icon="user"
      id="sobre-mi-titulo"
    />

    <div class="about">
      <!-- ------------------------------------------------------- Retrato -->
      <div class="about__portrait" data-reveal>
        <div class="portrait">
          {profile.photo ? (
            <img
              class="portrait__img"
              src={profile.photo}
              alt={`Retrato de ${profile.name}`}
              width="420"
              height="420"
              loading="lazy"
              decoding="async"
            />
          ) : (
            <span class="portrait__monogram" aria-hidden="true">{profile.initials}</span>
          )}
          <span class="orbit-ring orbit-ring--outer" aria-hidden="true"></span>
          <span class="orbit-ring orbit-ring--inner" aria-hidden="true"></span>
        </div>
      </div>

      <!-- --------------------------------------------------------- Texto -->
      <div class="about__content">
        <h3 class="about__role" data-reveal>{profile.role}</h3>

        <p class="about__summary" data-reveal style="--reveal-delay:80ms">
          {profile.summary}
        </p>

        <ul class="about__facts" role="list">
          {datos.map((dato, index) => (
            <li
              class="about__fact"
              data-reveal
              data-reveal-group="facts"
              style={`--reveal-delay:${120 + index * 60}ms`}
            >
              <span class="about__fact-icon"><Icon name={dato.icon} size={16} /></span>
              <span class="about__fact-body">
                <span class="about__fact-label">{dato.label}</span>
                {dato.href ? (
                  <a class="about__fact-value about__fact-value--link" href={dato.href}>
                    {dato.value}
                  </a>
                ) : (
                  <span class="about__fact-value">{dato.value}</span>
                )}
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 320px) minmax(0, 1fr);
    gap: clamp(2rem, 1rem + 4vw, 4rem);
    align-items: start;
  }

  /* Una sola consulta de medios: por debajo de 900 px, una columna */
  @media (max-width: 900px) {
    .about { grid-template-columns: 1fr; }
    .about__portrait { justify-self: center; }
  }

  /* ----------------------------------------------------------- Retrato */
  .portrait {
    position: relative;
    display: grid;
    place-items: center;
    width: min(300px, 70vw);
    aspect-ratio: 1;
  }

  .portrait__img,
  .portrait__monogram {
    width: 78%;
    height: 78%;
    border-radius: var(--radius-full);
    object-fit: cover;
  }

  .portrait__monogram {
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 30% 25%, hsl(var(--hsl-nebula) / 0.55), transparent 62%),
      var(--color-surface-high);
    border: 1px solid var(--color-border-strong);
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 1.8rem + 3vw, 4rem);
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-text);
  }

  /* Anillos orbitales: dos circunferencias punteadas girando a distinta
     velocidad y en sentidos opuestos. Solo se anima `rotate`, que la GPU
     resuelve sin recalcular el layout. */
  .orbit-ring {
    position: absolute;
    inset: 0;
    border-radius: var(--radius-full);
    border: 1px dashed var(--color-border-strong);
    animation: orbit 34s linear infinite;
  }

  .orbit-ring--inner {
    inset: 9%;
    border-style: solid;
    border-color: hsl(var(--hsl-plasma) / 0.25);
    animation-duration: 22s;
    animation-direction: reverse;
  }

  /* --------------------------------------------------------- Contenido */
  .about__role {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-4);
  }

  .about__summary {
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
    margin-bottom: var(--space-6);
  }

  .about__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .about__fact {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .about__fact-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    border-radius: var(--radius-md);
    background: var(--color-surface-high);
    border: 1px solid var(--color-border);
    color: var(--color-plasma);
  }

  .about__fact-body { display: flex; flex-direction: column; min-width: 0; }

  .about__fact-label {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-dim);
  }

  .about__fact-value {
    font-size: var(--text-sm);
    color: var(--color-text);
    overflow-wrap: anywhere; /* el correo no debe romper la rejilla en movil */
  }

  .about__fact-value--link:hover { color: var(--color-plasma); }
</style>
